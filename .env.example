# Copy to .env, edit Google credentials, then run bun run setup:env.
APP_BASE_URL=http://localhost:3000
API_ORIGIN=http://127.0.0.1:8787
# 許可する大学・学校・会社のメールドメインをカンマ区切りで指定
ALLOWED_EMAIL_DOMAINS=company.example
DEFAULT_EXPIRY_DAYS=14
MAX_EXPIRY_DAYS=30
MIN_EXPIRY_DAYS=1
MAX_FILE_BYTES=1048576
MAX_BATCH_FILES=5
MAX_ACTIVE_SHARES_PER_USER=100
SESSION_TTL_SECONDS=604800
# 独立した暗号化鍵（64桁hex）。setup:envで生成。一度使った鍵を変更・紛失しないこと。
CONTENT_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebとMCPを合算したユーザーごとの1分間の操作上限
USER_RATE_LIMIT_PER_MINUTE=120
