{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "share-html-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "share-html-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 */12 * * *"]
  },
  "vars": {
    "APP_BASE_URL": "http://localhost:3000",
    "ALLOWED_EMAIL_DOMAINS": "students.university.example,university.example",
    "DEFAULT_EXPIRY_DAYS": "14",
    "MAX_EXPIRY_DAYS": "30",
    "MIN_EXPIRY_DAYS": "1",
    "MAX_FILE_BYTES": "1048576",
    "MAX_BATCH_FILES": "5",
    "MAX_ACTIVE_SHARES_PER_USER": "100",
    "SESSION_TTL_SECONDS": "604800",
    "USER_RATE_LIMIT_PER_MINUTE": "120"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "PUBLIC_IP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
